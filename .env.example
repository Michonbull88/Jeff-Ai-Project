# Local text and Excel tutor model. Install Ollama and pull this model first.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
# Optional: needed only for OpenAI Realtime voice and OpenAI-backed web search.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
# Required in production; choose a long, random password.
JEFF_ACCESS_CODE=
# Signs local user sessions. Use a separate long, random value in production.
JEFF_AUTH_SECRET=
# Public site origin, required behind a reverse proxy if its origin differs.
# APP_ORIGIN=https://jeff.example.com

# Paid features require an explicit opt-in. Excel tutoring uses Ollama.
JEFF_ENABLE_OPENAI=false
